# ==============================================================================
# CONAMOR, — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Base de Datos PostgreSQL, Auth & Row Level Security)
# Obtén tus credenciales desde tu proyecto en https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Cloudinary (Almacenamiento y Optimización de Imágenes CDN)
# Obtén tus llaves desde https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 3. Stripe Connect (Pagos, Aportaciones & Cuentas Express para México)
# Obtén tus llaves de prueba desde: https://dashboard.stripe.com/test/apikeys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 4. Google Stitch
# ------------------------------------------------------------------------------
STITCH_PROJECT_ID=6501009366121445546
STITCH_API_KEY=
